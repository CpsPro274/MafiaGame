server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Nginx's docker-entrypoint automatically provides LOCAL_RESOLVERS from /etc/resolv.conf
    resolver ${LOCAL_RESOLVERS} valid=10s;

    location / {
        try_files $uri /index.html;
    }

    # Proxy API requests
    location /api/ {
        set $api_upstream http://${BACKEND_INTERNAL_URL};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Proxy WebSockets
    location /socket.io/ {
        set $socket_upstream http://${BACKEND_INTERNAL_URL};
        proxy_pass $socket_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }
}